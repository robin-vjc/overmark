{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Minimal permissions for the overlay windows. No network, filesystem or shell access.",
  "windows": ["overlay-*"],
  "permissions": [
    "core:event:default",
    "store:allow-load",
    "store:allow-get",
    "store:allow-set",
    "store:allow-save"
  ]
}
